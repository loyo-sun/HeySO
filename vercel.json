{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/heyso.mjs": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/heyso?__heyso_route=/api/:path*" },
    { "source": "/mcp", "destination": "/api/heyso?__heyso_route=/mcp" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
