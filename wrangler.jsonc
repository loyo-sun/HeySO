{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heyso",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp"]
  },
  "durable_objects": {
    "bindings": [{ "name": "HEYSO_WORKSPACE", "class_name": "HeysoWorkspace" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HeysoWorkspace"] }]
}
